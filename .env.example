# Telegram Bot Configuration
# Create a bot via @BotFather on Telegram and paste the token here
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Optional: Restrict bot to listen only to your Telegram user/chat ID (check with @userinfobot)
TELEGRAM_CHAT_ID=your_chat_id_here

# Background price refresh interval in seconds (default: 300 = 5 minutes)
PRICE_REFRESH_INTERVAL=300

# Docker Host Port Mappings (optional overrides)
FRONTEND_PORT=3000
BACKEND_PORT=8000
